# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# --- Login (required) ---
# Your meinwohnticket.wien login (Stadt Wien Konto / mein.wien.gv.at).
# The bot logs in by itself on every run, so no session cookie is needed.
WB_USERNAME=
WB_PASSWORD=

# --- Telegram notifications (on by default) ---
# 1) Create a bot with @BotFather in Telegram and paste its token here.
# 2) Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}.
# Several chat IDs can be given comma separated.
ENABLE_TELEGRAM=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email notifications (off by default) ---
# Set ENABLE_EMAIL=1 to additionally (or instead) get notified by email.
ENABLE_EMAIL=0
EMAIL_SENDER=your_email@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENTS=you@example.com,partner@example.com
SMTP_SERVER=mail.gmx.net
SMTP_PORT=587

# --- Reference point for distance calculation ---
# Coordinates the distance in each message is measured from (e.g. your workplace).
# Default: Stephansplatz, Vienna city center.
REF_LAT=48.208490
REF_LON=16.372080

# --- AI scoring (optional) ---
# Works with any provider offering an OpenAI-compatible API; switching provider
# only means changing these three values. Examples:
#   OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1                                OPENAI_MODEL=gpt-5-mini
#   Gemini:     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ OPENAI_MODEL=gemini-flash-lite-latest
#               (free key at https://aistudio.google.com/apikey)
#   DeepInfra:  OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai                      OPENAI_MODEL=deepseek-ai/DeepSeek-V3
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1                             OPENAI_MODEL=deepseek/deepseek-chat
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama            OPENAI_MODEL=llama3.2
# Set ENABLE_AI=0 to run without AI scoring.
ENABLE_AI=1
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_MODEL=gemini-flash-lite-latest

# Base prompt for the AI evaluation (German, since listings are German).
# Customize this to describe what YOU care about in an apartment.
APT_EVAL_BASE_PROMPT="Bewerte die Qualität der Wohnung auf einer Skala von 0 bis 100 und gib eine kurze Begründung für deine Bewertung. Berücksichtige Größe, Zimmeranzahl, Kosten, Stockwerk, Freiflächen und die Distanz zum Referenzpunkt (kleiner ist besser)."

# --- Search (required) ---
# Set up your filters at https://www.meinwohnticket.wien/wohnungen and paste the
# resulting URL from the address bar here. Filters are read from the URL.
SEARCH_URL=https://www.meinwohnticket.wien/wohnungen?anzahlRaeume=3-7&flaeche=65-

# --- Automatic application (optional, OFF by default) ---
# WARNING: when enabled, the bot submits real applications on your
# Wohnberatung Wien account (using the login above).
# Read the README section "Automatic application" before turning this on.
AUTOMATIC_APPLICATION=0
# An apartment must meet ALL of the following to trigger an application:
# Maximum distance to your reference point in meters
AUTO_MAX_DISTANCE_M=3000
# Minimum size in square meters (strictly greater-than)
AUTO_MIN_SIZE_SQM=74
# Minimum floor level
AUTO_MIN_FLOOR_LEVEL=3
# Optional: cancel your existing application for this apartment before
# applying to a new one (you can only have three open applications). Use the
# UUID from the apartment's URL: https://www.meinwohnticket.wien/wohnungen/<UUID>
# Leave empty to skip.
CANCEL_APPLICATION_APT_ID=

# --- Runtime settings ---
# (On GitHub Actions, SENT_IDS_FILE, LOG_FILE and LOG_LEVEL are set by the workflow.)
# File that tracks already-notified apartment IDs
SENT_IDS_FILE=sent_apartments.txt
# Delay between detail requests (seconds) to be nice to the server
DETAIL_DELAY=0.3
# Leave LOG_FILE empty to log to the terminal instead of a file
LOG_FILE=logfile.log
LOG_LEVEL=INFO
